#--------------------------------------------------------------------
# RASMEIN — Environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# BRAND
#--------------------------------------------------------------------
rasmein.brandName = 'Rasmein'
rasmein.supportEmail = 'hello@rasmein.com'
rasmein.supportPhone = '+91 00000 00000'

#--------------------------------------------------------------------
# DATABASE
#
# XAMPP / WAMP defaults: username "root", password EMPTY.
#   database.default.hostname = 127.0.0.1     <- safer than "localhost" on
#                                                Windows, where localhost can
#                                                resolve to IPv6 and mysqli
#                                                then fails to connect
#   database.default.username = root
#   database.default.password = ''
#   database.default.port     = 3306          <- check the XAMPP Control Panel;
#                                                it uses 3307 if 3306 was taken
#
# Create the database first (phpMyAdmin, or the CLI):
#   CREATE DATABASE rasmein CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Then: php spark rasmein:diag   (tells you exactly what is still wrong)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = rasmein
database.default.username = rasmein
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION  — generate with: php spark key:generate
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'rasmein_session'
session.expiration = 7200
session.savePath = null

#--------------------------------------------------------------------
# COOKIES  — secure MUST be true in production (HTTPS only)
#--------------------------------------------------------------------
cookie.prefix = 'rsm_'
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# EMAIL (SMTP)
#--------------------------------------------------------------------
email.fromEmail = 'orders@rasmein.com'
email.fromName = 'Rasmein'
email.protocol = 'smtp'
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

#--------------------------------------------------------------------
# SMS / WHATSAPP  (provider-agnostic; wired in a later phase)
#--------------------------------------------------------------------
sms.enabled = false
sms.provider =
sms.apiKey =
sms.senderId =

#--------------------------------------------------------------------
# PAYMENT GATEWAY — DISABLED. Enable in the payments phase.
#--------------------------------------------------------------------
payment.enabled = false
payment.gateway = 'razorpay'
razorpay.keyId =
razorpay.keySecret =
razorpay.webhookSecret =
