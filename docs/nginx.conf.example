# =====================================================================
# RASMEIN — nginx server block (reference)
# Mirrors public/.htaccess for an nginx + PHP-FPM deployment.
# =====================================================================

server {
    listen 443 ssl http2;
    server_name rasmein.com www.rasmein.com;

    # The document root is public/ — never the project root.
    root /var/www/rasmein/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/rasmein.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rasmein.com/privkey.pem;

    # Do not advertise the stack.
    server_tokens off;
    fastcgi_hide_header X-Powered-By;

    autoindex off;
    client_max_body_size 8m;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        include        fastcgi_params;
        fastcgi_pass   unix:/run/php/php8.3-fpm.sock;
        fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_index  index.php;
    }

    # Framework internals: unreachable even if the root is misconfigured.
    location ~ ^/(app|system|writable|vendor|tests|resources|docs|node_modules)/ {
        deny all;
        return 404;
    }

    # Dotfiles and sensitive filenames.
    location ~ /\.(?!well-known) { deny all; return 404; }
    location ~ ^/(composer\.(json|lock)|package(-lock)?\.json|spark|preload\.php|CLAUDE\.md)$ {
        deny all; return 404;
    }

    # No PHP execution in the uploads tree, whatever gets written there.
    location ^~ /uploads/ {
        location ~ \.(php|phtml|phar|pl|py|cgi|sh)$ { deny all; return 404; }
        add_header X-Content-Type-Options nosniff always;
        expires 6M;
    }

    # Assets are mtime-busted by rs_asset(), so a long TTL is safe.
    location ~* \.(css|js|svg|woff2|jpg|jpeg|png|webp|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}

server {
    listen 80;
    server_name rasmein.com www.rasmein.com;
    return 301 https://$host$request_uri;
}
